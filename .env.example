# Copia este archivo como .env y coloca tu clave.
# Consíguela gratis en https://aistudio.google.com/apikey
GOOGLE_API_KEY=YOUR_GOOGLE_API_KEY_HERE

# Modelo de Gemini (opcional). gemini-2.5-flash-lite está en la capa
# gratuita; también funcionan gemini-2.5-pro o gemini-3.8-flash.
GEMINI_MODEL=gemini-2.5-flash-lite
